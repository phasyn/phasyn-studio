# Normalize line endings; the toolchain and shell scripts expect LF.
* text=auto eol=lf

# Binary assets
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.phasynplugin binary

# Generated files: collapse in diffs and exclude from language statistics
uv.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
**/uv.lock linguist-generated=true
apps/frontend/src/api/generated/** linguist-generated=true

# Vendored shaders are pinned by sha256 and kept byte for byte (one ships with CRLF).
runtimes/captioner/src/phasyn_captioner/upscale/third_party/anime4k/*.glsl -text
