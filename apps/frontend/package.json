{
  "name": "@phasyn-studio/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Phasyn Studio web UI: the engineering workbench for the Controller (React, TypeScript, Vite, Tailwind CSS)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phasyn/phasyn-studio.git",
    "directory": "apps/frontend"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-editor-kernel.mjs && vite build && python3 -I scripts/package-krita.py",
    "preview": "vite preview",
    "typecheck": "node scripts/check-editor-kernel.mjs && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings=0 && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "gen:types": "node scripts/gen-contracts.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs --out node_modules/.cache/i18n-extract",
    "i18n:apply": "node scripts/i18n-codemod.mjs --apply",
    "i18n:check": "node scripts/i18n-check.mjs",
    "gen:kernel": "node scripts/build-editor-kernel.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "14.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.4",
    "@eslint/js": "^10.0.1",
    "@react-three/eslint-plugin": "0.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
