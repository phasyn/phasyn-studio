          "additionalProperties": true
        },
        "part_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartOverride"
          },
          "default": []
        },
        "provider_options": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "device"
      ],
      "additionalProperties": false
    },
    "PartOverride": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "maxLength": 16384
        },
        "settings": {
          "type": "object",
          "additionalProperties": true
