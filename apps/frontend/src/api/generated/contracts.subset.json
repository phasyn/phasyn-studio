        },
        "invoke": {
          "type": "object",
          "additionalProperties": true
        },
        "recording": {
          "$ref": "#/$defs/RecorderConfig"
        }
      },
      "required": [
        "load",
        "invoke",
        "recording"
      ],
      "additionalProperties": false
