{
  "$comment": "Synthetic. Shared cases for the two evaluators of plugin rules (the web UI and the reference evaluator). registry.json in this directory is the registry (contract StudioPluginList) every case is evaluated against; a case with \"registry\": \"unavailable\" is evaluated without one. Input: plugins (the project's prompt_plugins), prompt and settings (the values the shot would render with; null = cannot be determined). expect: problems (references that cannot be used), forbidden and missing (prompt rules), unmet (generation requirements), the prompt to send, and blocked. These files are ASCII: every other character is written as a JSON Unicode escape, so that a reader sees which character a case is about. tools/contracts/sync_studio_plugins.py --check verifies every case with the reference evaluator.",
  "registry": "registry.json",
  "cases": [
    {
      "name": "every requirement holds",
      "plugins": [
        "com.example.dev-pack/tv-720p",
        "com.example.dev-pack/fast-sampling"
      ],
      "prompt": "A duel on a rooftop.",
      "settings": {
        "format": {
          "width": 1280,
          "height": 736
        },
        "frames": 141,
        "steps": 8,
        "video_shift": 3,
        "audio_shift": 3,
        "route_capability": "t2va",
        "reference_video_short_edge": 768
      },
      "expect": {
        "problems": [],
        "forbidden": [],
        "missing": [],
        "unmet": [],
        "prompt": "A duel on a rooftop.",
        "blocked": false
      }
    },
    {
      "name": "frame size and frame count are not among the allowed values",
      "plugins": [
        "com.example.dev-pack/tv-720p"
      ],
      "prompt": "A duel on a rooftop.",
      "settings": {
        "format": {
          "width": 1920,
          "height": 1088
        },
        "frames": 107,
        "steps": 8,
        "video_shift": 3,
        "audio_shift": 3,
        "route_capability": "t2va",
        "reference_video_short_edge": 768
      },
      "expect": {
        "problems": [],
        "forbidden": [],
        "missing": [],
        "unmet": [
          {
            "ref": "com.example.dev-pack/tv-720p",
            "check": "size"
          },
          {
            "ref": "com.example.dev-pack/tv-720p",
            "check": "length"
          }
        ],
        "prompt": "A duel on a rooftop.",
        "blocked": true
      }
    },
    {
      "name": "a frame size matches only when width and height both match",
      "plugins": [
        "com.example.dev-pack/tv-720p"
      ],
      "prompt": "A duel on a rooftop.",
      "settings": {
        "format": {
          "width": 1280,
          "height": 704
        },
        "frames": 141,
        "steps": 8,
        "video_shift": 3,
        "audio_shift": 3,
        "route_capability": "t2va",
        "reference_video_short_edge": 768
      },
      "expect": {
        "problems": [],
        "forbidden": [],
        "missing": [],
