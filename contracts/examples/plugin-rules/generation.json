          {
            "ref": "com.example.dev-pack/tv-720p",
            "check": "size"
          }
        ],
        "prompt": "A duel on a rooftop.",
        "blocked": true
      }
    },
    {
      "name": "numbers compare by value: 3.0 is 3, 5.5 is allowed",
