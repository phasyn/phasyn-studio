      "component_id": "te-uma0",
      "label": "H3 文字條件（Qwen3-VL TE，統一記憶體 GPU 常駐，BF16 原生精度）",
      "provider_id": "h3.conditioning",
      "runtime_id": "aarch64-sm121",
      "autostart": false,
      "folder": "生成/文字條件",
      "settings": {
        "load": {
          "model_path": "/path/to/models",
          "device": {
            "kind": "cuda",
            "id": "GPU-REPLACE-2",
            "resource_group": "gpu-uma"
          },
          "part_overrides": [],
          "precision": {
            "compute_dtype": "native"
          },
          "offload": {
            "mode": "none",
            "after_use": "device"
          },
          "provider_options": {
            "variant": "fl2va",
            "shared_from": "ref2va",
            "mode": "exact",
            "encoder_max_tokens": 32768
