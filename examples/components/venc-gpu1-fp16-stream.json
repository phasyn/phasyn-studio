{
  "component_id": "venc-gpu1-fp16-stream",
  "label": "Video VAE Encode（GPU 1，FP16 因果串流，approximate；參考影片以 FP16 權重與激活編碼，參考圖照舊 FP32）",
  "provider_id": "h3.video_encode",
  "runtime_id": "x86_64",
