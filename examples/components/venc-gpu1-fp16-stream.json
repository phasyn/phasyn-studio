      },
      "provider_options": {
        "variant": "fl2va",
        "shared_from": "ref2va",
        "mode": "approximate",
        "video_vae_scope": "encode_only",
        "frame_streaming": {
          "enabled": true,
          "frames_per_pass": 2,
          "precision": "fp16"
        }
      }
    },
    "invoke": {},
    "recording": {
      "mode": "detailed"
    }
  }
