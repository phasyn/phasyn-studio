{
  "pipeline_id": "art-return",
  "label": "美術修改稿回程",
  "inputs": [
    {
      "name": "image_file",
      "type_id": "media.image.v1",
      "required": false,
      "transport": "file",
      "description": "參考圖或繪製完成的修改稿"
    },
    {
      "name": "video_file",
      "type_id": "media.video.v1",
      "required": false,
      "transport": "file",
      "description": "參考影片或繪製完成的修改稿"
    },
    {
      "name": "manifest_file",
      "type_id": "art.exchange-manifest.v1",
