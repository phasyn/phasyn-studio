        "manifest_file": {
          "from_input": "manifest_file"
        }
      },
      "parameters": {
        "operation": "return"
      }
    }
  ],
  "outputs": {
    "delivery_file": {
      "from_step": "exchange",
      "output": "delivery_file"
    },
    "manifest_file": {
      "from_step": "exchange",
      "output": "manifest_file"
    },
    "report": {
      "from_step": "exchange",
      "output": "report"
    }
  }
