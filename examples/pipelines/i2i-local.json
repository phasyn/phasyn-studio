{
  "pipeline_id": "i2i-local",
  "label": "圖生圖：前處理（CPU）→ TE ‖ VAE encode → DiT BF16 phase → VAE decode → 遮罩合成（CPU）",
  "inputs": [
    {
      "name": "prompt",
      "type_id": "text.prompt.v1",
      "required": true,
      "transport": "inline",
      "description": "生成 prompt（verbatim；不截斷，超過 text encoder 上限 → PROMPT_TOO_LONG）"
    },
    {
      "name": "negative_prompt",
      "type_id": "text.prompt.v1",
      "required": false,
      "transport": "inline",
      "description": "negative prompt：只有 te.cfg=true（guidance > 1）時編碼"
    },
    {
      "name": "references",
      "type_id": "qimg.references.v1",
      "required": true,
      "transport": "inline",
      "description": "參考圖 [{file: FileRef, label?}]（1–4 張，依序）"
    },
    {
      "name": "mask",
      "type_id": "media.image.v1",
      "required": false,
      "transport": "file",
      "description": "編輯遮罩（白＝重新生成、黑＝保留 base_index 那張參考圖）"
    }
  ],
  "steps": [
    {
      "step_id": "prepare",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-prepare",
      "inputs": {
        "references": {
          "from_input": "references"
        },
        "mask": {
          "from_input": "mask"
        }
      },
      "parameters": {
        "width": 1024,
        "height": 1024,
        "reference_resolution": 1024,
        "base_index": 0,
        "mask_invert": false
      }
    },
    {
      "step_id": "te",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-te-gpu0",
      "inputs": {
        "prompt": {
          "from_input": "prompt"
        },
        "negative_prompt": {
          "from_input": "negative_prompt"
        },
        "prepared": {
          "from_step": "prepare",
          "output": "prepared"
        }
      },
      "parameters": {
        "cfg": false
      }
    },
    {
      "step_id": "venc",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-venc-gpu0",
      "inputs": {
        "prepared": {
          "from_step": "prepare",
          "output": "prepared"
        }
      },
      "parameters": {
        "tiling": false
      }
    },
    {
      "step_id": "dit",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-dit-bf16-phase-gpu0",
      "inputs": {
        "conditioning": {
          "from_step": "te",
          "output": "conditioning"
        },
        "ref_latents": {
          "from_step": "venc",
          "output": "ref_latents"
        }
      },
      "parameters": {
        "width": 1024,
        "height": 1024,
        "steps": 40,
        "guidance": 1.0,
        "seed": 42
      }
    },
    {
      "step_id": "vae",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-vae-gpu0",
      "inputs": {
        "latent": {
          "from_step": "dit",
          "output": "latent"
        }
      },
      "parameters": {
        "mode": "full"
      }
    },
    {
      "step_id": "compose",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "image-compose",
      "inputs": {
        "image": {
          "from_step": "vae",
          "output": "image"
        },
        "prepared": {
          "from_step": "prepare",
          "output": "prepared"
        }
      },
      "parameters": {}
    }
  ],
  "outputs": {
    "image": {
      "from_step": "compose",
      "output": "image"
    },
    "image_white": {
      "from_step": "compose",
      "output": "image_white"
    }
  }
}
