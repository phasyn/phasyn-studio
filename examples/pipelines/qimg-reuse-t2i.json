{
  "pipeline_id": "qimg-reuse-t2i",
  "label": "Qwen 文生圖：沿用編碼產物生成圖片",
  "inputs": [
    {
      "name": "conditioning",
      "type_id": "qimg.conditioning.v1",
      "required": true,
      "transport": "file",
      "description": "沿用編碼時的 prompt、參考圖與 CFG 模式。"
    }
  ],
  "steps": [
    {
      "step_id": "dit",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-dit-bf16-phase-gpu0",
      "inputs": {
        "conditioning": {
          "from_input": "conditioning"
        }
      },
      "parameters": {
        "width": 1024,
        "height": 1024,
        "steps": 40,
        "guidance": 1.0,
        "seed": 42
      }
    },
    {
      "step_id": "vae",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-vae-gpu0",
      "inputs": {
        "latent": {
          "from_step": "dit",
          "output": "latent"
        }
      },
      "parameters": {
        "mode": "full"
      }
    },
    {
      "step_id": "compose",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "image-compose",
      "inputs": {
        "image": {
          "from_step": "vae",
          "output": "image"
        }
      },
      "parameters": {}
    }
  ],
  "outputs": {
    "image": {
      "from_step": "compose",
      "output": "image"
    },
    "image_white": {
      "from_step": "compose",
      "output": "image_white"
    }
  }
}
