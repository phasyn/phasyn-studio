{
  "pipeline_id": "t2i-local",
  "label": "文生圖：TE（sequential）→ DiT BF16 phase → VAE decode → 合成（CPU）",
  "inputs": [
    {
      "name": "prompt",
      "type_id": "text.prompt.v1",
      "required": true,
      "transport": "inline",
      "description": "生成 prompt（verbatim；不截斷，超過 text encoder 上限 → PROMPT_TOO_LONG）"
    },
    {
      "name": "negative_prompt",
      "type_id": "text.prompt.v1",
      "required": false,
      "transport": "inline",
      "description": "negative prompt：只有 te.cfg=true（guidance > 1）時編碼"
    }
  ],
  "steps": [
    {
      "step_id": "te",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-te-gpu0",
      "inputs": {
        "prompt": {
          "from_input": "prompt"
        },
        "negative_prompt": {
          "from_input": "negative_prompt"
        }
      },
      "parameters": {
        "cfg": false
      }
    },
    {
      "step_id": "dit",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-dit-bf16-phase-gpu0",
      "inputs": {
        "conditioning": {
          "from_step": "te",
          "output": "conditioning"
        }
      },
      "parameters": {
        "width": 1024,
        "height": 1024,
        "steps": 40,
        "guidance": 1.0,
        "seed": 42
      }
    },
    {
      "step_id": "vae",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "qimg-vae-gpu0",
      "inputs": {
        "latent": {
          "from_step": "dit",
          "output": "latent"
        }
      },
      "parameters": {
        "mode": "full"
      }
    },
    {
      "step_id": "compose",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "image-compose",
      "inputs": {
        "image": {
          "from_step": "vae",
          "output": "image"
        }
      },
      "parameters": {}
    }
  ],
  "outputs": {
    "image": {
      "from_step": "compose",
      "output": "image"
    },
    "image_white": {
      "from_step": "compose",
      "output": "image_white"
    }
  }
}
