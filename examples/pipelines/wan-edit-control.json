{
  "pipeline_id": "wan-edit-control",
  "label": "Wan VACE · 以控制影片生成",
  "inputs": [
    {
      "name": "prompt",
      "type_id": "text.prompt.v1",
      "required": true,
      "transport": "inline",
      "description": "Describe the resulting shot"
    },
    {
      "name": "control",
      "type_id": "media.video.v1",
      "required": true,
      "transport": "file",
      "description": "Frame-aligned pose, depth, edge or rendered layout guide"
    },
    {
      "name": "reference",
      "type_id": "media.image.v1",
      "required": false,
      "transport": "file",
      "description": "Optional visual reference"
    }
  ],
  "steps": [
    {
      "step_id": "edit",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "wan-edit",
      "inputs": {
        "prompt": {
          "from_input": "prompt"
        },
        "control": {
          "from_input": "control"
        },
        "reference": {
          "from_input": "reference"
        }
      },
      "parameters": {
        "operation": "control"
      }
    }
  ],
  "outputs": {
    "final": {
      "from_step": "edit",
      "output": "asset"
    },
    "video_file": {
      "from_step": "edit",
      "output": "video_file"
    }
  }
}
