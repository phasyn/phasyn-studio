{
  "pipeline_id": "wan-edit-depth",
  "label": "Wan VACE · 擷取相對深度並生成",
  "inputs": [
    {
      "name": "prompt",
      "type_id": "text.prompt.v1",
      "required": true,
      "transport": "inline",
      "description": "Describe the resulting shot"
    },
    {
      "name": "source",
      "type_id": "media.video.v1",
      "required": true,
      "transport": "file",
      "description": "Source performance or layout video"
    },
    {
      "name": "reference",
      "type_id": "media.image.v1",
      "required": false,
      "transport": "file",
      "description": "Optional visual reference"
    }
  ],
  "steps": [
    {
      "step_id": "capture",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "depth-control",
      "inputs": {
        "video_file": {
          "from_input": "source"
        }
      },
      "parameters": {
        "frame_index": 0
      }
    },
    {
      "step_id": "edit",
      "node_id": "00000000-0000-4000-8000-0000000000a1",
      "component_id": "wan-edit",
      "inputs": {
        "prompt": {
          "from_input": "prompt"
        },
        "control": {
          "from_step": "capture",
          "output": "video_file"
        },
        "reference": {
          "from_input": "reference"
        }
      },
      "parameters": {
        "operation": "control"
      }
    }
  ],
  "outputs": {
    "final": {
      "from_step": "edit",
      "output": "asset"
    },
    "video_file": {
      "from_step": "edit",
      "output": "video_file"
    },
    "guide": {
      "from_step": "capture",
      "output": "video_file"
    }
  }
}
