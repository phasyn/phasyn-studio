{
  "schema_version": "1.0",
  "provider_id": "media.take_analysis",
  "label": "Black and stationary frame review",
  "kind": "media.prepare",
  "inputs": [
    {
      "name": "video",
      "type_id": "media.video.v1",
      "required": true,
      "transport": "file",
      "description": "Source video"
    }
  ],
  "outputs": [
    {
      "name": "report",
      "type_id": "media.take_analysis.v1",
      "required": true,
      "transport": "file",
      "description": "JSON findings with source frame/time ranges"
    },
    {
      "name": "evidence",
      "type_id": "media.image.v1",
      "required": true,
      "transport": "file",
      "description": "PNG contact sheet of source frames"
    }
  ],
  "parameters_schema": {
    "type": "object",
    "properties": {
      "min_seconds": {
        "type": "number",
        "default": 0.5,
        "minimum": 0.04,
        "maximum": 60
      },
      "black_ratio": {
        "type": "number",
        "default": 0.98,
        "minimum": 0.5,
        "maximum": 1
      },
      "black_luma": {
        "type": "number",
        "default": 0.1,
        "minimum": 0,
        "maximum": 1
      },
      "freeze_noise": {
        "type": "number",
        "default": 0.001,
        "minimum": 0,
        "maximum": 0.2
      }
    },
    "additionalProperties": false
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "load": {
        "type": "object",
        "properties": {
          "model_path": {
            "type": "string",
            "description": "Node 本機模型路徑（使用者提供，不由主控下載）"
          },
          "model_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "cpu"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[^\\x00-\\x1f\\x7f]*$"
              },
              "resource_group": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "resource_group"
            ],
            "additionalProperties": false
          },
          "precision": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "offload": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "part_overrides": {
            "type": "array"
          },
          "provider_options": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        "required": [
          "device"
        ],
        "additionalProperties": false
      },
      "invoke": {
        "type": "object",
        "properties": {
          "min_seconds": {
            "type": "number",
            "default": 0.5,
            "minimum": 0.04,
            "maximum": 60
          },
          "black_ratio": {
            "type": "number",
            "default": 0.98,
            "minimum": 0.5,
            "maximum": 1
          },
          "black_luma": {
            "type": "number",
            "default": 0.1,
            "minimum": 0,
            "maximum": 1
          },
          "freeze_noise": {
            "type": "number",
            "default": 0.001,
            "minimum": 0,
            "maximum": 0.2
          }
        },
        "additionalProperties": false
      },
      "recording": {
        "type": "object"
      }
    },
    "required": [
      "load",
      "invoke",
      "recording"
    ],
    "additionalProperties": false
  },
  "default_settings": {
    "load": {
      "device": {
        "kind": "cpu",
        "id": "cpu",
        "resource_group": "cpu-media"
      }
    },
    "invoke": {},
    "recording": {
      "device_sample_hz": 2,
      "publish_interval_ms": 1000,
      "batch_max_events": 256,
      "batch_max_bytes": 262144,
      "queue_max_events": 8192,
      "queue_max_bytes": 16777216,
      "segment_bytes": 67108864,
      "max_detail_bytes_per_recording": 2147483648,
      "cuda_pending_event_pairs": 4096,
      "trace_steps": [
        0,
        1
      ],
      "trace_parts": [],
      "record_shapes": false,
      "with_stack": false,
      "capture_prompt": true,
      "tensor_dump": false,
      "capture_stderr": true,
      "finite_scan": false,
      "gpu_event_timing": true,
      "log_level": "info",
      "parts": [],
      "steps": [],
      "mode": "detailed"
    }
  },
  "entry_point": "phasyn_media.providers.take_analysis:TakeAnalysisProvider",
  "operations": [
    "take_analysis",
    "contact_sheet"
  ],
  "resources": {
    "devices": [
      "cpu"
    ],
    "required_modules": [],
    "executables": [
      "ffmpeg",
      "ffprobe"
    ],
    "vram_bytes": 0,
    "memory_basis": "Runs FFmpeg signal analysis and writes a bounded contact sheet."
  },
  "execution": {
    "cache": "none",
    "retry": "verify_stopped_first",
    "cancellation": "cooperative",
    "progress": [
      "stage"
    ],
    "error_contract": "ComponentError",
    "retry_condition": "Execution produces new artifacts. Verify the previous attempt and outputs before retry."
  },
  "models": [],
  "license": "Apache-2.0",
  "capability_version": "1.0.0"
}
