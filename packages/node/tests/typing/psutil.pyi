from typing import NamedTuple

class Error(Exception): ...

NoSuchProcess: type[Error]

class _VirtualMemory(NamedTuple):
    total: int
    available: int

class _SwapMemory(NamedTuple):
    used: int

class _ProcessMemory(NamedTuple):
    rss: int

STATUS_ZOMBIE: str

class Process:
    pid: int
    def __init__(self, pid: int | None = ...) -> None: ...
    def memory_info(self) -> _ProcessMemory: ...
    def children(self, *, recursive: bool = ...) -> list[Process]: ...
    def cmdline(self) -> list[str]: ...
    def status(self) -> str: ...
    def kill(self) -> None: ...

def virtual_memory() -> _VirtualMemory: ...
def swap_memory() -> _SwapMemory: ...
def pid_exists(pid: int) -> bool: ...
