{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact-ref",
  "description": "Phasyn Studio H3 recipe contract",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "artifact_id",
    "sha256",
    "size_bytes",
    "media_type"
  ],
  "additionalProperties": false
}
