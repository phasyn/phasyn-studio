{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job-request",
  "description": "Phasyn Studio H3 recipe contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "client_request_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "execution_target": {
      "type": "string",
      "enum": [
        "generation",
        "conditioning"
      ],
      "default": "generation",
      "description": "conditioning 僅產生可追溯 TE bundle；不執行 DiT/VAE 或宣告影片／角色品質通過"
    },
    "prompt": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "context_mode": {
          "type": "string",
          "enum": [
            "verbatim",
            "local_rewrite",
            "official_api"
          ],
          "default": "verbatim"
        }
      },
      "required": [
        "text",
        "context_mode"
      ],
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "$ref": "artifact-ref.schema.json"
          },
          "role": {
            "type": "string",
            "enum": [
              "first_frame",
              "last_frame",
              "reference_image",
              "reference_video",
              "reference_audio"
            ]
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400,
            "default": 0
          },
          "end_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              {
                "type": "null"
              }
            ]
          },
          "use_embedded_audio": {
            "type": "boolean",
            "default": true
          },
          "hold_last_frame": {
            "type": "boolean",
            "default": false
          },
          "condition_noise": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "artifact",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "output": {
      "type": "object",
      "properties": {
        "requested_seconds": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 3600,
          "default": 5
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 24
        },
        "width": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096,
          "default": 864
        },
        "height": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096,
          "default": 480
        },
        "duration_policy": {
          "type": "string",
          "enum": [
            "preserve_generated",
            "trim_to_requested"
          ],
          "default": "preserve_generated"
        },
        "container": {
          "type": "string",
          "enum": [
            "mp4",
            "mkv"
          ],
          "default": "mp4"
        },
        "video_codec": {
          "type": "string",
          "enum": [
            "h264",
            "hevc",
            "av1"
          ],
          "default": "h264"
        },
        "audio_codec": {
          "type": "string",
          "enum": [
            "aac",
            "pcm"
          ],
          "default": "aac"
        },
        "pixel_format": {
          "type": "string",
          "enum": [
            "yuv420p",
            "yuv420p10le"
          ],
          "default": "yuv420p"
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 51,
          "default": 18
        },
        "encode_provider": {
          "type": "string",
          "enum": [
            "auto_validated",
            "cpu_ffmpeg",
            "nvenc"
          ],
          "default": "auto_validated"
        },
        "audio_bitrate": {
          "type": "integer",
          "minimum": 64000,
          "maximum": 512000,
          "default": 192000
        },
        "frame_delivery": {
          "type": "string",
          "enum": [
            "local_encode",
            "materialized_chunks"
          ],
          "default": "local_encode"
        }
      },
      "required": [
        "requested_seconds",
        "fps",
        "width",
        "height",
        "duration_policy",
        "container",
        "video_codec",
        "audio_codec"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "video_shift": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100,
          "default": 12
        },
        "audio_shift": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100,
          "default": 3
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "scheduler": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "steps",
        "video_shift",
        "audio_shift",
        "seed",
        "scheduler"
      ],
      "additionalProperties": false
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "profile_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "default": 5
    },
    "allow_experimental": {
      "type": "boolean",
      "default": false
    },
    "allow_external_processing": {
      "type": "boolean",
      "default": false
    },
