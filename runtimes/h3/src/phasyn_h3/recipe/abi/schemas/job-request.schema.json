                {
                  "type": "object",
                  "properties": {
                    "policy_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "digest": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "policy_id",
                    "revision",
                    "digest"
                  ],
                  "additionalProperties": false
