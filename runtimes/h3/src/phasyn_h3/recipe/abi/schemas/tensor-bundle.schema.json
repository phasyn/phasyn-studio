{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tensor-bundle",
  "description": "Phasyn Studio H3 recipe contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "enum": [
        "video_latent",
        "audio_latent",
        "reference_latents",
        "decoded_frames",
        "decoded_audio"
      ]
    },
    "is_fixture": {
      "type": "boolean"
    },
    "payload": {
      "$ref": "artifact-ref.schema.json"
    },
    "model_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "normalization_config_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "tensors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "dtype": {
            "type": "string",
            "enum": [
              "BF16",
              "F32",
              "I64",
              "I32",
              "BOOL",
              "U8"
            ]
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "minItems": 1,
            "maxItems": 8
          },
          "layout": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "dtype",
          "shape",
          "layout",
          "byte_length"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "metadata_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "is_fixture",
    "payload",
    "model_digest",
    "adapter_digest",
    "plan_digest",
    "stage_id",
    "normalization_config_digest",
    "tensors",
    "metadata_digest"
  ],
  "additionalProperties": false
}
