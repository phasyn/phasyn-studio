{
  "label": "Wan VACE 文字與首幀生成",
  "kind": "wan.generate",
  "inputs": [
    {
      "name": "prompt",
      "type_id": "text.prompt.v1",
      "required": true,
      "transport": "inline",
      "description": "Describe the resulting shot"
    },
    {
      "name": "first_frame",
      "type_id": "media.image.v1",
      "required": false,
      "transport": "file",
      "description": "First-frame anchor"
    },
    {
      "name": "reference",
      "type_id": "media.image.v1",
      "required": false,
      "transport": "file",
      "description": "Optional visual reference"
    }
  ],
  "outputs": [
    {
      "name": "asset",
      "type_id": "media.asset.v1",
      "required": true,
      "transport": "inline",
      "description": "Complete derived video Asset"
    },
    {
      "name": "video_file",
      "type_id": "media.video.v1",
      "required": true,
      "transport": "file",
      "description": "Independent silent MP4"
    }
  ],
  "parameters_schema": {
    "type": "object",
    "properties": {
      "width": {
        "type": "integer",
        "minimum": 128,
        "maximum": 1280,
        "multipleOf": 16
      },
      "height": {
        "type": "integer",
        "minimum": 128,
        "maximum": 1280,
        "multipleOf": 16
      },
      "frames": {
        "type": "integer",
        "minimum": 1,
        "maximum": 129
      },
      "steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 30
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "default": 42
      },
      "guidance": {
        "type": "number",
        "minimum": 1,
        "maximum": 20,
        "default": 5
      },
      "conditioning_scale": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 1
      },
      "fps_num": {
        "type": "integer",
        "minimum": 1,
        "maximum": 240000
      },
      "fps_den": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1001
      },
